{
  "manifest_version": 3,
  "name": "Jobright Apply Filter",
  "version": "1.3.0",
  "description": "Filter Jobright cards, download job links, or send your filtered list to Kula APP on this computer.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Jobright Apply Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://jobright.ai/*", "https://www.jobright.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
